# Definizione degli insiemi

## I: insieme delle località
L = ["loc1", "loc2", "loc3", "loc4", "loc5", "loc6"]

## J: insieme dei quartieri
Q = ["q1", "q2", "q3", "q4", "q5", "q6"]

# Definizione dei parametri

